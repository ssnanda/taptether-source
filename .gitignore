# Generated builds and local tooling
.dart_tool/
.flutter-plugins*
.packages
**/build/
**/.gradle/
**/DerivedData/
**/Pods/
**/.symlinks/
**/Flutter/ephemeral/
**/Generated.xcconfig
**/flutter_export_environment.sh
# Flutter regenerates these host-specific runner files during CI setup.
app/android/local.properties
app/ios/**/GeneratedPluginRegistrant.h
app/ios/**/GeneratedPluginRegistrant.m
# Keep Gradle wrapper scripts/JARs eligible for source control when the
# Android runner becomes repository-owned; do not blanket-ignore gradle/.
.idea/
.vscode/
*.iml
.DS_Store
# Never commit local agent identity or credentials
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.mobileprovision
*.keystore
*.jks
config.local.json
dist/
coverage/

# Agent packages are built locally before mobile builds
app/assets/agents/*
!app/assets/agents/.gitkeep

# Generated platform-specific brand icons
app/assets/branding/*.png
app/ios/Runner/Assets.xcassets/AppIcon.appiconset/*.png
app/android/app/src/main/res/mipmap-*/ic_launcher.png
tv/lg-webos/icon.png
tv/lg-webos/largeIcon.png
